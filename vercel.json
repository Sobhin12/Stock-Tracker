{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["bom1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{app.py,config.py,excel_store.py,storage.py,fetchers/**}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }]
}
